<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.enclave.sbxd-darwin</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/enclave/sbxd-darwin</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/Users/admin/Library/Logs/Enclave/sbxd-darwin.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/admin/Library/Logs/Enclave/sbxd-darwin.log</string>
</dict>
</plist>
